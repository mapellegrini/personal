#!/bin/bash


#/mnt/backup
if mountpoint -q /mnt/data && mountpoint -q /mnt/backup; then
    echo "Archiving /mnt/data"
    mkdir -p /mnt/backup/daily
    date >> /mnt/backup/daily/cronlog.daily
    rsync --archive --delete /mnt/data /mnt/backup/daily >> /mnt/backup/cronlog.daily 2>&1
    rc=$?
    if [ "$rc" -eq 0 ]; then
        echo "SUCCESS: /mnt/data backup completed" >> /mnt/backup/cronlog.daily
    else
        echo "ERROR: /mnt/data backup failed (rsync exit code $rc)" >> /mnt/backup/cronlog.daily
    fi
    echo "Archiving configuration files"
    rsync --archive --delete /etc /mnt/backup/daily >> /mnt/backup/cronlog.daily 2>&1
    rc=$?
    if [ "$rc" -eq 0 ]; then
        echo "SUCCESS: /etc backup completed" >> /mnt/backup/cronlog.daily
    else
        echo "ERROR: /etc backup failed (rsync exit code $rc)" >> /mnt/backup/cronlog.daily
    fi
else
    echo "/mnt/data is not mounted or /mnt/backup is not mounted"
fi

